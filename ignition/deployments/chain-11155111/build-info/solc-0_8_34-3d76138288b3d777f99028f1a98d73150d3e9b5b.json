      "project/contracts/Greeter.sol": {
        "content": "\r\n // SPDX-License-Identifier: MIT\r\npragma solidity ^0.8.24;\r\n\r\ncontract Greeter {\r\n    string private name;\r\n\r\n    constructor(string memory _name) {\r\n        name = _name;\r\n    }\r\n\r\n    function greet() public view returns (string memory) {\r\n        return string(abi.encodePacked(\"Hello, \", name, \"!\"));\r\n    }\r\n}\r\n"
